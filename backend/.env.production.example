# Variáveis para o deploy de produção (docker-compose.prod.yml / Coolify)
# Copie para .env, preencha os valores e NUNCA versione o .env real.

# Banco de dados (container Postgres interno ao compose)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=troque-por-uma-senha-forte
POSTGRES_DB=postgres

# Chave usada para assinar/validar os tokens JWT — compartilhada entre
# auth-service, demand-service e metrics-service. Gere com:
#   openssl rand -base64 48
JWT_SECRET=troque-por-um-segredo-longo-e-aleatorio

# Token do Cloudflare Tunnel dedicado a este projeto (Zero Trust > Networks
# > Tunnels > Create a tunnel > Docker > copie o valor depois de --token).
# Configure o Public Hostname do túnel apontando para http://api-gateway:8080
CLOUDFLARE_TUNNEL_TOKEN=troque-pelo-token-do-tunnel
