# Variáveis para o deploy de produção (docker-compose.prod.yml / Coolify)
# Copie para .env, preencha os valores e NUNCA versione o .env real.

# Banco de dados (container Postgres interno ao compose)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=troque-por-uma-senha-forte
POSTGRES_DB=postgres

# Chave usada para assinar/validar os tokens JWT — compartilhada entre
# auth-service, demand-service e metrics-service. Gere com:
#   openssl rand -base64 48
JWT_SECRET=troque-por-um-segredo-longo-e-aleatorio

# Códigos exigidos para criar conta com papel "gestor" no /auth/register.
# Cada código vincula o gestor a um órgão e define quais categorias ele enxerga.
# Formato: ORGAO=codigo separados por ponto e vírgula. Órgãos disponíveis:
#   GERAL (todas as categorias), ILUMINACAO, OBRAS_E_SANEAMENTO, LIMPEZA_URBANA,
#   TRANSITO, FISCALIZACAO_E_SEGURANCA
# Sem nenhum código configurado o cadastro de gestor fica fechado (403).
# Entregue cada código só a quem deve administrar aquele órgão. Gere com:
#   openssl rand -base64 24
GESTOR_ACCESS_CODES=GERAL=troque-1;ILUMINACAO=troque-2;OBRAS_E_SANEAMENTO=troque-3
# Opcional: um código único que libera a gestão geral (mantido por compatibilidade).
GESTOR_ACCESS_CODE=

# Redis (cache de indicadores e controle de sessões). Exige senha.
REDIS_PASSWORD=troque-por-uma-senha-forte

# Um usuário de banco por serviço, cada um limitado ao seu schema (veja postgres-init/).
# Em um banco que já existe, rode uma vez:
#   docker compose -f docker-compose.prod.yml exec postgres sh /docker-entrypoint-initdb.d/002-roles.sh
AUTH_DB_PASSWORD=troque-por-uma-senha-forte
DEMAND_DB_PASSWORD=troque-por-uma-senha-forte
METRICS_DB_PASSWORD=troque-por-uma-senha-forte

# Verificação em duas etapas (MFA) dos gestores. Vem DESLIGADA: com MFA_HABILITADO=false ninguém consegue ativá-la
# e o app esconde a opção. O código está pronto; para usar, ligue e configure a chave abaixo.
MFA_HABILITADO=false
# MFA_ENCRYPTION_KEY cifra o segredo do autenticador no banco. Sem ela, em produção, a MFA fica indisponível.
# Gere com: openssl rand -base64 32   (guarde fora do repositório e não troque depois de ter MFA ativa)
MFA_ENCRYPTION_KEY=
# Chaves que protegem o e-mail no banco. Obrigatórias: sem elas auth e demand não sobem em produção.
# DADOS_ENCRYPTION_KEY cifra o e-mail (a mesma nos dois serviços); EMAIL_HASH_KEY gera o valor de busca do login.
# Gere cada uma com: openssl rand -base64 32   (guarde fora do repositório; trocar uma delas exige migrar os dados)
DADOS_ENCRYPTION_KEY=
EMAIL_HASH_KEY=
# Com true, o cadastro responde igual para qualquer e-mail e a conta só entra depois de confirmar o código enviado
# por e-mail. Exige SMTP configurado (SMTP_HOST etc.): sem ele ninguém consegue concluir o cadastro.
CONFIRMACAO_EMAIL_HABILITADA=false
# Com true, todo gestor precisa ativar a MFA no próximo login. Com false, a MFA é opcional.
MFA_OBRIGATORIO_GESTOR=false

# E-mail de redefinição de senha (SMTP). Sem SMTP_HOST o e-mail não é enviado.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=RESOLVE <nao-responda@seu-dominio.com.br>
# Esquema do link do app (deep link) usado no e-mail.
APP_DEEPLINK=resolve://

# Opcionais (valores padrão entre parênteses)
# LOGIN_MAX_FALHAS=3               falhas seguidas até bloquear o login
# LOGIN_BLOQUEIO_MINUTOS=15        duração do bloqueio
# TOKEN_REDEFINICAO_MINUTOS=30     validade do código de redefinição de senha
# LOG_RETENCAO_DIAS=365            retenção dos registros de autenticação
# RETENCAO_ANOS=5                  retenção das denúncias resolvidas
# TERMOS_VERSAO=1.0                versão vigente da Política de Privacidade/Termos de Uso
# CORS_ORIGINS=                    origens web permitidas (o app mobile não precisa)

# Token do Cloudflare Tunnel dedicado a este projeto (Zero Trust > Networks
# > Tunnels > Create a tunnel > Docker > copie o valor depois de --token).
# Configure o Public Hostname do túnel apontando para http://api-gateway:8080
CLOUDFLARE_TUNNEL_TOKEN=troque-pelo-token-do-tunnel
