PORT=3001
DATABASE_URL="postgresql://postgres:postgrespassword@localhost:5432/postgres?schema=auth"
REDIS_URL=redis://localhost:6379
# Obrigatório: o serviço não sobe sem JWT_SECRET (em testes usa um valor interno).
JWT_SECRET=change-me
DEMAND_SERVICE_URL=http://localhost:3002
# Código de cadastro de gestor. Em produção não existe valor padrão.
GESTOR_ACCESS_CODE=change-me-codigo-gestor
# Alternativa por órgão: GESTOR_ACCESS_CODES=GERAL=codigo1;ILUMINACAO=codigo2
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
# Verificação em duas etapas dos gestores. Desligada por padrão (MFA_HABILITADO=false).
MFA_HABILITADO=false
# Verificação em duas etapas dos gestores. Em desenvolvimento, sem a chave, ela é derivada do JWT_SECRET.
# Em produção a chave é obrigatória: openssl rand -base64 32
MFA_ENCRYPTION_KEY=
# Protegem o e-mail no banco. Em produção são obrigatórias: openssl rand -base64 32
DADOS_ENCRYPTION_KEY=
EMAIL_HASH_KEY=
MFA_OBRIGATORIO_GESTOR=false
# Confirmação de e-mail no cadastro (exige SMTP). Desligada por padrão.
CONFIRMACAO_EMAIL_HABILITADA=false
