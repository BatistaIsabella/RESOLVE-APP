datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = ["auth"]
}

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["multiSchema"]
}

model Usuario {
  id               Int       @id @default(autoincrement())
  nome             String    @db.VarChar(100)
  email            String    @unique @db.VarChar(254)
  senha            String    @db.VarChar(60)
  papel            Papel     @default(CIDADAO)
  orgao            String?   @db.VarChar(40)
  aceite_termos_em DateTime?
  versao_termos    String?   @db.VarChar(20)
  // Verificação em duas etapas (TOTP). O segredo fica cifrado; ver utils/cifra.ts.
  mfa_segredo      String?   @db.VarChar(200)
  mfa_ativo        Boolean   @default(false)
  mfa_ultimo_passo Int?

  tokensRedefinicao  TokenRedefinicao[]
  codigosRecuperacao CodigoRecuperacaoMfa[]

  @@map("usuarios")
  @@schema("auth")
}

model TokenRedefinicao {
  id         Int       @id @default(autoincrement())
  usuario_id Int
  token_hash String    @unique @db.VarChar(64)
  expira_em  DateTime
  usado_em   DateTime?
  criado_em  DateTime  @default(now())
  usuario    Usuario   @relation(fields: [usuario_id], references: [id], onDelete: Cascade)

  @@index([usuario_id])
  @@map("tokens_redefinicao")
  @@schema("auth")
}

model CodigoRecuperacaoMfa {
  id          Int       @id @default(autoincrement())
  usuario_id  Int
  codigo_hash String    @db.VarChar(64)
  usado_em    DateTime?
  usuario     Usuario   @relation(fields: [usuario_id], references: [id], onDelete: Cascade)

  @@index([usuario_id])
  @@map("mfa_codigos_recuperacao")
  @@schema("auth")
}

model TentativaLogin {
  chave         String    @id @db.VarChar(64)
  falhas        Int       @default(0)
  bloqueado_ate DateTime?
  atualizado_em DateTime  @updatedAt

  @@map("tentativas_login")
  @@schema("auth")
}

model EventoAuth {
  id            Int      @id @default(autoincrement())
  tipo          String   @db.VarChar(40)
  usuario_id    Int?
  identificador String?  @db.VarChar(64)
  ip            String?  @db.VarChar(64)
  user_agent    String?  @db.VarChar(255)
  detalhe       String?  @db.VarChar(255)
  criado_em     DateTime @default(now())

  @@index([criado_em])
  @@index([usuario_id])
  @@map("eventos_auth")
  @@schema("auth")
}

enum Papel {
  CIDADAO
  GESTOR

  @@schema("auth")
}
