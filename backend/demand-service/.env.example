PORT=3002
REDIS_URL=redis://localhost:6379
DATABASE_URL="postgresql://postgres:postgrespassword@localhost:5432/postgres?schema=demand"
# Obrigatório: deve ser o mesmo valor do auth-service.
JWT_SECRET=change-me
# Cifra o e-mail do solicitante no banco (a mesma do auth-service). Em produção é obrigatória: openssl rand -base64 32
DADOS_ENCRYPTION_KEY=
# RETENCAO_ANOS=5
# Limites das fotos de cada denúncia (padrões: 5 fotos de até 2 MB)
IMAGENS_MAX_POR_DENUNCIA=5
IMAGEM_MAX_BYTES=2097152
